<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>JojoHats</AssemblyName>
    <Version>0.5.2</Version>
    <!-- Public release DLLs must not embed the author's absolute PDB path. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(PeakManagedDir)' == ''" Text="Set PeakManagedDir to the local PEAK_Data/Managed directory, or use scripts/build.ps1." />
    <Error Condition="'$(BepInExCoreDir)' == ''" Text="Set BepInExCoreDir to a local BepInEx/core directory, or use scripts/build.ps1." />
    <Error Condition="'$(MoreCustomizationsDll)' == ''" Text="Set MoreCustomizationsDll to the local MoreCustomizations.dll (tested: 1.1.10), or use scripts/build.ps1." />
  </Target>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="MoreCustomizations" HintPath="$(MoreCustomizationsDll)" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(PeakManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(PeakManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(PeakManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(PeakManagedDir)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(PeakManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
  </ItemGroup>
</Project>
