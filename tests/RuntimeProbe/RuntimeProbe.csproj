<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>JojoHats.RuntimeProbe</AssemblyName>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(PeakManagedDir)' == ''" Text="Set PeakManagedDir to the local PEAK_Data/Managed directory." />
    <Error Condition="'$(BepInExCoreDir)' == ''" Text="Set BepInExCoreDir to the isolated BepInEx/core directory." />
    <Error Condition="'$(MoreCustomizationsDll)' == ''" Text="Set MoreCustomizationsDll to the local MoreCustomizations.dll (tested: 1.1.10)." />
  </Target>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)/BepInEx.dll" Private="false" />
    <Reference Include="MoreCustomizations" HintPath="$(MoreCustomizationsDll)" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(PeakManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(PeakManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(PeakManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
</Project>
